# ============================================================
# MANA VIVAHA (TSAP Matrimony) — ENV TEMPLATE
# Copy: cp .env.example .env  → values fill chey → docker-compose up -d --build
# ============================================================

# ---- Brand / site ----
SITE_URL=https://manavivaha.in
YEAR=2025

# ---- Telegram ----
BOT_TOKEN=123456:ABC-your-bot-token
BOT_USERNAME=@telugumatrimony1_bot
ADMIN_CHAT_ID=123456789
CHANNELS=TSBRIDE,TSGROOM1

# ---- Payments (Razorpay) ----
RAZORPAY_KEY=rzp_test_xxxx
RAZORPAY_SECRET=xxxx

# ---- DB / cache ----
DATABASE_URL=postgresql://tsap:tsap123@postgres:5432/tsap_matrimony
REDIS_URL=redis://redis:6379
ENV=production

# ---- AUTO-PUBLISH (register avvagane Telegram + WhatsApp ki post) ----
AUTO_POST_ON_REGISTER=true      # false ayithe approve tarvata matrame post
PUBLISH_DRY_RUN=false           # true ayithe post cheyyadu (test) — token lekapothe auto-true
PUBLISH_RETRIES=3               # per channel retries
PUBLISH_RATE_LIMIT=1.2          # seconds gap per channel (Telegram spam safe)

# ---- WhatsApp ----
# off | cloud_api | bridge
WHATSAPP_MODE=off

# Option A — Official Meta WhatsApp Business Cloud API (best for broadcast, opt-in users)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=9198480xxxxx,9197012xxxxx

# Option B — Local bridge (Baileys): groups/community ki post (QR scan once)
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3001     # base URL (code '/send' suffix handle chestundi)
WHATSAPP_BRIDGE_TARGETS=120363xxxxxxxx@g.us,9198480xxxxx@s.whatsapp.net
PUBLIC_BASE_URL=https://manavivaha.in     # card image URL (bridge image fetch cheyyadaniki)

# ---- WHATSAPP ANTI-BAN (🛡️ random gap 120–170s — ban risk thakkuva) ----
# Order: TELEGRAM post ayyaka → WHATSAPP (random gap lo). Interest messages fast lane lo.
WA_ENABLED=true
WA_MIN_GAP=120                  # prati WhatsApp post madhya minimum gap (seconds)
WA_MAX_GAP=170                  # maximum gap — random ga ee madhya untundi
WA_MIN_GAP_INTEREST=60          # interest/request messages ki fast lane
WA_MAX_GAP_INTEREST=120
WA_BREAK_EVERY=6                # prati 6 messages ki okasari pedda break
WA_BREAK_MIN_MIN=8              # break 8–20 min (manishi la)
WA_BREAK_MAX_MIN=20
WA_LONG_PAUSE_CHANCE=0.08       # 8% chance extra 3–8 min pause
WA_DAILY_CAP=60                 # rojuki total messages (warmup day-1 lo 33% matrame)
WA_TARGET_DAILY_CAP=8           # okate channel/group ki rojuki max
WA_ACTIVE_START=8               # 8AM (IST) nunchi
WA_ACTIVE_END=22                # 10PM (IST) varaku — raatri aapitam
WA_WARMUP_DAYS=4                # kotha number ramp: 33% → 55% → 75% → 100%
WA_FAIL_COOLDOWN_MIN=30         # 3 failures → 30 min auto-pause
WA_TEST_FAST=false              # true = gap 1–2 sec (ONLY tests)

# ---- INTEREST / REQUEST MODEL (🚫 chatting ledu) ----
INTEREST_MAX_PER_DAY=20         # oka user rojuki max requests (spam block)
INTEREST_EXPIRY_DAYS=7          # 7 days lo reply rakapothe auto expire
INTEREST_REFUND_ON_DECLINE=true # decline/withdraw aithe credit refund (trust)
PAYMENT_AUTO_APPROVE=true       # true = demo lo ventane credits; Razorpay live ayyaka false
DEMO_SEED_ENABLED=true          # startup lo 4 demo profiles (production lo false)

# ---- GROWTH: NAMASTE WELCOME + LEAD CAPTURE + LAUNCH INVENTORY ----
ADMIN_WHATSAPP_NUMBER=          # admin/matcher WhatsApp — kotha registration alert ikkadiki (91XXXXXXXXXX)
SUPPORT_PHONE=9100000000        # trust line — profiles lo kanipisthundi
LAUNCH_SEED_COUNT=60            # startup lo launch inventory profiles (VM lo 360 pettandi, production lo 0)
LAUNCH_TARGET_PROFILES=360      # "300-400 profiles chalu" gauge target

# ---- Frontend → backend proxy (docker service name) ----
BACKEND_URL=http://backend:8000
